Flight management: There are flight paths between cities. If there is a flight between
city A and city B, then there is an edge between the cities. The cost of the edge can be
the time that flight takes to reach city B from A, or the amount of fuel used for the
journey.
Write a menu driven C++ program to represent this as a graph using adjacency matrix
and adjacency list. The node can be represented by the airport name or name of the city.
Check whether cities are connected through flight or not. Compare the storage
representation.


#include<iostream>
using namespace std;

#define MAX 10

class graphNode {
public:
	int vertex;
	string cityName;
	int time;
	int fuel;
	graphNode* next;
	
	graphNode() {
		vertex = -1;
		cityName = "";
		time = 0;
		fuel = 0;
		next = NULL;
	}
};

class Flight {
	graphNode* head[MAX];
	string cities[MAX];
	int city;
public:
	Flight() {
		city = 0;
		for(int i=0; i<MAX; i++) {
			head[i] = NULL;
		}
	}
	
	void readCity();
	void createGraph();
	void displayGraph();
	void path();
	void connectivity();
};

void Flight :: readCity() {
	cout<<"Enter the number of cities: ";
	cin>>city;
	
	for(int i=0; i<city; i++) {
		cout<<"Enter city "<<i<<": ";
		cin>>cities[i];
	}
}

void Flight :: createGraph() {
	int t, f;
	for(int i=0; i<city; i++) {
		for(int j=0; j<city; j++) {
			if(i == j) continue;
			
			cout<<endl<<"Flights from "<<cities[i]<<" to "<<cities[j]<<": "<<endl;
			cout<<"Enter the time required (0 if no path): ";
			cin>>t;
			
			if(t != 0) {
				cout<<"Enter the fuel required: ";
				cin>>f;
				
				graphNode* newNode = new graphNode;
				newNode->vertex = j;
				newNode->cityName = cities[j];
				newNode->time = t;
				newNode->fuel = f;
				
				if(head[i] == NULL) {
					head[i] = newNode;
				} else {
					graphNode* temp = head[i];
					 while(temp->next != NULL) {
					 	temp = temp->next;
					 }
					 temp->next = newNode;
				}
			}
		}
	}
}

void Flight :: displayGraph() {
	cout<<endl<<"Adjacency List Representation: "<<endl;
	for(int i=0; i<city; i++) {
		cout<<cities[i]<<" -> ";
		graphNode* temp = head[i];
		while(temp != NULL) {
			cout << "["<< temp->cityName<< ", Time=" << temp->time<< ", Fuel=" << temp->fuel<< "] -> ";

            temp = temp->next;
		}
		
		cout<<"NULL"<<endl;
	}
}

void Flight :: path() {
	int source, destination;
	
	cout<<"Enter source city index: ";
	cin>>source;
	
	cout<<"Enter destination city index: ";
	cin>>destination;
	
	graphNode* temp = head[source];
	
	while(temp != NULL) {
		if(temp->vertex == destination) {
			cout<<"Path Exists"<<endl;
			cout<<"Time Required is: "<<temp->time<<endl;
			cout<<"Fuel Required is: "<<temp->fuel<<endl;
			return;
		}
		temp = temp->next;
	}
	
	cout<<"No Path Exists"<<endl;
}

void Flight :: connectivity() {
	int source, destination;
	
	cout<<"Enter source city index: ";
	cin>>source;
	
	cout<<"Enter destination city index: ";
	cin>>destination;
	
	graphNode* temp = head[source];
	
	while(temp != NULL) {
		if(temp->vertex == destination) {
			cout<<"Direct Path Exists"<<endl;
			return;
		}
		temp = temp->next;
	}
	
	temp = head[source];
	while(temp != NULL) {
		int intermediate = temp->vertex;
		graphNode* temp2 = head[intermediate];
		
		while(temp2 != NULL) {
			if(temp2->vertex == destination) {
				cout<<"Indirect Path Exists through "<<cities[intermediate]<<endl;
				return;
			}
			temp2 = temp2->next;
		}
		temp = temp->next;
	}
	cout<<"No Connectivity Found"<<endl;
}

int main() {

    Flight obj;
    int choice;

    do {
        cout << "1. Read Cities"<<endl;
        cout << "2. Create Flight Graph"<<endl;
        cout << "3. Display Flight Graph"<<endl;
        cout << "4. Path"<<endl;
        cout << "5. Connectivity"<<endl;
        cout << "0. Exit"<<endl;

        cout << "Enter your choice: ";
        cin >> choice;

        switch(choice) {

        case 1:
            obj.readCity();
            break;

        case 2:
            obj.createGraph();
            break;

        case 3:
            obj.displayGraph();
            break;

        case 4:
            obj.path();
            break;

        case 5:
            obj.connectivity();
            break;

        case 0:
            cout << "Exiting Program..." << endl;
            break;

        default:
            cout << "Invalid Choice!" << endl;
        }

    } while(choice != 0);

    return 0;
}

